{
  "manifest_version": 3,
  "name": "Skribbl Dare — Challenges & Achievement Badges",
  "version": "1.0.0",
  "description": "Adds randomized drawing dares, a 'Completed Dare' reward button, and achievement stickers/titles to Skribbl.io with Discord login.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.skribbl.io/*",
    "https://deafening-overtime-penknife.ngrok-free.dev/*",
    "http://localhost:8090/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Skribbl Dare Dashboard",
    "default_icon": "assets/icons/icon.svg"
  },
  "icons": {
    "128": "assets/icons/icon.svg"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.skribbl.io/*"
      ],
      "js": [
        "content/skribbl.js"
      ],
      "css": [
        "content/skribbl.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/stickers/*.svg",
        "assets/icons/*.svg"
      ],
      "matches": [
        "*://*.skribbl.io/*"
      ]
    }
  ]
}
